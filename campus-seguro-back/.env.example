# ===== OBRIGATÓRIAS (o servidor NÃO sobe sem elas) =====

# Banco de dados PostgreSQL. Exemplos:
#   postgresql://usuario:senha@localhost:5432/campus_seguro
#   (Neon/Supabase/Render fornecem uma URL pronta; "postgres://" é convertido automaticamente)
DATABASE_URL=

# Chave secreta para assinar os tokens JWT. Gere uma aleatória, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ===== IA (OpenRouter) =====
# Necessária para a rota /ocorrencias/ia/preview funcionar.
# Sem ela, o app faz fallback e segue o fluxo manualmente.
OPENROUTER_API_KEY=

# ===== Microserviço Llama (opcional) =====
URL_LLAMA_API=

# ===== Cloudflare R2 / S3 (upload de evidências) — OPCIONAL =====
# Se ficarem vazias, os anexos são salvos localmente na pasta uploads/.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
