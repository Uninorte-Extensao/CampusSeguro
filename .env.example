# Configuração do docker-compose (copie para .env e preencha).
# Gere valores aleatórios com, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Porta onde o app fica acessível no servidor (http)
WEB_PORT=80

# HTTPS com certificado automático (perfil "https" do docker compose).
# Sem domínio próprio, use o IP com sslip.io, ex.: 13-140-47-133.sslip.io
DOMINIO=

# Senha do PostgreSQL (usada só entre os containers)
POSTGRES_PASSWORD=

# Chave para assinar os tokens JWT
SECRET_KEY=

# Administrador criado automaticamente na subida
# (rodar de novo atualiza a senha). A senha precisa ter 8+ caracteres,
# uma maiúscula, um número e um caractere especial.
ADMIN_NOME=Diretor Carlos Eduardo Mendes
ADMIN_EMAIL=diretor@campusseguro.edu.br
ADMIN_SENHA=

# Opcionais
OPENROUTER_API_KEY=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
