# URL base da API do backend (FastAPI).
# - Emulador Android: http://10.0.2.2:8000  (padrão automático)
# - iOS simulator / Web: http://localhost:8000  (padrão automático)
# - Dispositivo físico: use o IP da sua máquina na rede local, ex.:
#     EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
#
# Se não definir, o app escolhe o padrão por plataforma automaticamente.
EXPO_PUBLIC_API_URL=
